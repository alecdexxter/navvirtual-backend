spring.application.name=navvirtual-backend
server.port=8082

spring.datasource.url=jdbc:postgresql://localhost:5433/navvirtual
spring.datasource.username=navvirtual_user
spring.datasource.password=navvirtual_pass

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

